      {
        "name": "Key_Measures",
        "columns": [
          {
            "name": "Measure_ID",
            "dataType": "int64",
            "isHidden": true,
            "lineageTag": "533081c3-7ee1-49e3-b307-c9d54fbc463b",
            "sourceColumn": "Measure_ID"
          }
        ],
        "lineageTag": "3c0ee9aa-63e2-4186-b9f5-23e583467110",
        "measures": [
          {
            "name": "Total Fleet Rentals",
            "expression": "SUM(Daily_Analytics[cnt])",
            "formatString": "#,##0",
            "lineageTag": "31f4f9e3-5e3e-4969-bbc7-639a80ad5de8"
          },
          {
            "name": "Casual Rentals",
            "expression": "SUM(Daily_Analytics[casual])",
            "formatString": "#,##0",
            "lineageTag": "56454899-9406-44fb-9390-ff10eca0a259"
          },
          {
            "name": "Registered Rentals",
            "expression": "SUM(Daily_Analytics[registered])",
            "formatString": "#,##0",
            "lineageTag": "1e676ce9-bae9-4be3-8bc5-c8d243afc6b3"
          },
          {
            "name": "Casual Share %",
            "expression": "DIVIDE([Casual Rentals], [Total Fleet Rentals], 0)",
            "formatString": "0.0%",
            "lineageTag": "9c2b97b4-e5d2-4a1a-bab5-25a3a7507ee3"
          },
          {
            "name": "Registered Share %",
            "expression": "DIVIDE([Registered Rentals], [Total Fleet Rentals], 0)",
            "formatString": "0.0%",
            "lineageTag": "da11da8d-e78c-4f08-adc0-9e6c36103359"
          },
          {
            "name": "Daily Average Rentals",
            "expression": "AVERAGE(Daily_Analytics[cnt])",
            "formatString": "#,##0",
            "lineageTag": "5a8cdab2-9002-4b68-b425-0883fa833169"
          },
          {
            "name": "Hourly Average Demand",
            "expression": "AVERAGE(Hourly_Analytics[cnt])",
            "formatString": "#,##0",
            "lineageTag": "b1991a42-d1cb-44c5-b8fa-23206aaf62e5"
          },
          {
            "name": "Total Tracked Days",
            "expression": "DISTINCTCOUNT(Daily_Analytics[dteday])",
            "formatString": "#,##0",
            "lineageTag": "c0db3f80-1b1d-40f7-90c3-cd03f89ea1a4"
          },
          {
            "name": "YoY Growth %",
            "expression": "VAR R2011 = CALCULATE([Total Fleet Rentals], Daily_Analytics[year_label] = \"2011\") VAR R2012 = CALCULATE([Total Fleet Rentals], Daily_Analytics[year_label] = \"2012\") RETURN DIVIDE(R2012 - R2011, R2011, 0)",
            "formatString": "+0.0%;-0.0%;0.0%",
            "lineageTag": "3fb108eb-504b-4d51-a4c6-4528c44067ea"
          },
          {
            "name": "Peak Hourly Volume",
            "expression": "MAXX(SUMMARIZE(Hourly_Analytics, Hourly_Analytics[hr], \"HourlyVol\", AVERAGE(Hourly_Analytics[cnt])), [HourlyVol])",
            "formatString": "#,##0",
            "lineageTag": "0e4d0660-02c0-4ea1-8a09-4a708c052646"
          },
          {
            "name": "Model MAE (Random Forest)",
            "expression": "AVERAGEX(ML_Predictions, ABS(ML_Predictions[Residual_RF]))",
            "formatString": "#,##0.0",
            "lineageTag": "3682fb95-a904-42eb-8c8f-3a24ceabe8e1"
          },
          {
            "name": "Model R2 Score (RF)",
            "expression": "0.887",
            "formatString": "0.000",
            "lineageTag": "d817a05f-6d1e-4b32-bd51-163291bbb072"
          }
        ],
        "partitions": [
          {
            "name": "Key_Measures-Partition",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i45WMlSKjQUA\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Measure_ID = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Measure_ID\", Int64.Type}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
      },
