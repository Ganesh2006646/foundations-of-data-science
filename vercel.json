{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:endpoint*",
      "destination": "/api/index.py?endpoint=:endpoint*"
    },
    {
      "source": "/styles.css",
      "destination": "/review%20-2/dashboard/static/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/review%20-2/dashboard/static/app.js"
    },
    {
      "source": "/",
      "destination": "/review%20-2/dashboard/static/index.html"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{review -1/**,review -2/dataset/**,review -2/presentation/**,review -2/reports/**,review -2/Bike_Sharing_Case_Study.ipynb,**/__pycache__/**}"
    }
  }
}
